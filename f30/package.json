{
  "name": "jupyterlab-netcdf-viewer",
  "version": "0.1.0",
  "description": "JupyterLab extension for viewing NetCDF meteorological data",
  "keywords": [
    "jupyter",
    "jupyterlab",
    "jupyterlab-extension",
    "netcdf",
    "meteorology"
  ],
  "homepage": "https://github.com/your-username/jupyterlab-netcdf-viewer",
  "bugs": {
    "url": "https://github.com/your-username/jupyterlab-netcdf-viewer/issues"
  },
  "license": "BSD-3-Clause",
  "author": {
    "name": "Your Name",
    "email": "your.email@example.com"
  },
  "files": [
    "lib/**/*.{d.ts,eot,gif,html,jpg,js,js.map,json,png,svg,woff2,ttf}",
    "style/**/*.{css,js,eot,gif,html,jpg,json,png,svg,woff2,ttf}"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "style": "style/index.css",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/jupyterlab-netcdf-viewer.git"
  },
  "scripts": {
    "build": "jlpm run build:lib && jlpm run build:labextension:dev",
    "build:prod": "jlpm run clean && jlpm run build:lib && jlpm run build:labextension",
    "build:labextension": "jupyter labextension build .",
    "build:labextension:dev": "jupyter labextension build --development True .",
    "build:lib": "tsc",
    "clean": "jlpm run clean:lib",
    "clean:lib": "rimraf lib tsconfig.tsbuildinfo",
    "clean:labextension": "rimraf jupyterlab_netcdf_viewer/labextension",
    "clean:all": "jlpm run clean:lib && jlpm run clean:labextension",
    "eslint": "eslint . --ext .ts,.tsx --fix",
    "eslint:check": "eslint . --ext .ts,.tsx",
    "install:extension": "jlpm run build",
    "watch": "run-p watch:src watch:labextension",
    "watch:src": "tsc -w",
    "watch:labextension": "jupyter labextension watch ."
  },
  "dependencies": {
    "@jupyterlab/application": "^3.0.0 || ^4.0.0",
    "@jupyterlab/apputils": "^3.0.0 || ^4.0.0",
    "@jupyterlab/docregistry": "^3.0.0 || ^4.0.0",
    "@jupyterlab/filebrowser": "^3.0.0 || ^4.0.0",
    "@jupyterlab/services": "^6.0.0 || ^7.0.0",
    "@lumino/algorithm": "^1.0.0 || ^2.0.0",
    "@lumino/commands": "^1.0.0 || ^2.0.0",
    "@lumino/coreutils": "^1.0.0 || ^2.0.0",
    "@lumino/disposable": "^1.0.0 || ^2.0.0",
    "@lumino/messaging": "^1.0.0 || ^2.0.0",
    "@lumino/signaling": "^1.0.0 || ^2.0.0",
    "@lumino/widgets": "^1.0.0 || ^2.0.0",
    "plotly.js-dist-min": "^2.27.0"
  },
  "devDependencies": {
    "@jupyterlab/builder": "^3.0.0 || ^4.0.0",
    "@types/node": "^16.0.0 || ^20.0.0",
    "@types/plotly.js": "^2.12.30",
    "@typescript-eslint/eslint-plugin": "^5.0.0 || ^6.0.0",
    "@typescript-eslint/parser": "^5.0.0 || ^6.0.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^8.0.0 || ^9.0.0",
    "eslint-plugin-prettier": "^4.0.0 || ^5.0.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.0.0 || ^3.0.0",
    "rimraf": "^3.0.0 || ^5.0.0",
    "typescript": "~4.1.3 || ~5.1.6"
  },
  "sideEffects": [
    "style/*.css",
    "style/index.js"
  ],
  "styleModule": "style/index.js",
  "publishConfig": {
    "access": "public"
  },
  "jupyterlab": {
    "extension": true,
    "outputDir": "jupyterlab_netcdf_viewer/labextension",
    "webpackConfig": "./webpack.config.js",
    "sharedPackages": {
      "plotly.js-dist-min": {
        "bundled": true,
        "singleton": true
      }
    }
  }
}
