{
  "name": "modbus-plc-monitor",
  "version": "1.0.0",
  "description": "Modbus TCP PLC data acquisition and anomaly prediction service",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "test": "jest",
    "mock": "node tests/mockModbusServer.js",
    "init:devices": "node scripts/initDevices.js",
    "db:init": "node -e \"require('./src/models').sequelize.sync({force: true})\""
  },
  "dependencies": {
    "express": "^4.18.2",
    "ws": "^8.14.2",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.35.0",
    "modbus-serial": "^8.0.11",
    "jsmodbus": "^4.0.10",
    "json2csv": "^6.0.0-alpha.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "dotenv": "^16.3.1",
    "joi": "^17.11.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.7.0"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "keywords": [
    "modbus",
    "plc",
    "monitoring",
    "anomaly-detection"
  ],
  "author": "",
  "license": "MIT"
}
