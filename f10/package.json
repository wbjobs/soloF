{
  "name": "lz4-compression-service",
  "version": "1.0.0",
  "description": "High performance LZ4 compression service with WebAssembly",
  "main": "nodejs/src/index.js",
  "scripts": {
    "build:wasm": "cd cpp && emcc -O3 -s WASM=1 -s EXPORTED_FUNCTIONS=['_malloc','_free'] -s EXPORTED_RUNTIME_METHODS=['ccall','cwrap'] -o lz4_wasm.js lz4_wasm.cpp",
    "start": "node --expose-gc nodejs/src/index.js",
    "dev": "nodemon --expose-gc nodejs/src/index.js",
    "test": "jest",
    "test:memory": "node --expose-gc nodejs/test/memory_stress_test.js",
    "test:memory-fast": "ITERATIONS=100 FILE_SIZE=5 node --expose-gc nodejs/test/memory_stress_test.js"
  },
  "keywords": ["lz4", "compression", "wasm", "webassembly"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "ioredis": "^5.3.2",
    "prom-client": "^15.1.0",
    "multer": "^1.4.5-lts.1",
    "stream": "^0.0.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.7.0"
  }
}
